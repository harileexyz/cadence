# Database
DATABASE_URL="postgresql://cadence:cadence_dev_password@localhost:5438/cadence?schema=public"

# App URL (must match your OAuth redirect URI origin; use https://... if behind a tunnel)
APP_URL="http://localhost:3000"

# 32-byte hex key for AES-256-GCM OAuth token encryption
# Generate one with: openssl rand -hex 32
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Google / YouTube Data API v3 OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# Meta / Instagram API with Unified Login
META_APP_ID=""
META_APP_SECRET=""
META_CONFIG_ID=""

# Media Storage (optional S3 / Cloudflare R2).
# If omitted, files save to ./uploads and are served via PUBLIC_MEDIA_BASE_URL (or APP_URL).
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Optional override when testing Instagram locally with a tunnel (e.g. https://xyz.trycloudflare.com)
PUBLIC_MEDIA_BASE_URL=""
